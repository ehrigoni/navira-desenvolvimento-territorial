{
  "name": "navira-app",
  "version": "0.1.0",
  "description": "NAVIRA — plataforma de desenvolvimento territorial (MVP)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test src/lib/ethos-crypto.test.ts src/lib/questionario-ethos.test.ts src/lib/ethos-persistencia.test.ts src/lib/validacao-ethos.test.ts src/lib/matching.test.ts src/lib/porto-regras.test.ts src/lib/pagamento-porto.test.ts src/lib/contratacao-porto.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:importar-entidades": "tsx prisma/importar-entidades.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true
}
