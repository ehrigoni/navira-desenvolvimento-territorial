# PostgreSQL (ex.: postgresql://usuario:senha@localhost:5432/navira)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/navira?schema=public"

# Segredo para assinar o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET="troque-por-um-segredo-longo"

# URL pública da aplicação (usada no link de recuperação de senha)
APP_URL="http://localhost:3000"
