// ---------------------------------------------------------------------------
// Novos models / enums
// ---------------------------------------------------------------------------

enum Genero {
  MULHER
  HOMEM
  NAO_BINARIO
  OUTRO
  PREFIRO_NAO_INFORMAR
}

enum RacaCor {
  BRANCA
  PRETA
  PARDA
  AMARELA
  INDIGENA
  PREFIRO_NAO_INFORMAR
}

enum StatusCandidatura {
  ESCOLHIDA     // vaga só marcada em "Minhas vagas"
  CANDIDATADA
  ENTREVISTADA
  CONTRATADA
  RECUSADA
}

/// Inserção de um Navegante no mercado de trabalho. Fonte de vagas preenchidas, renda,
/// conexão local e retenção territorial.
model Contratacao {
  id           String    @id @default(cuid())
  naveganteId  String
  navegante    Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
  vagaId       String?
  vaga         Vaga?     @relation(fields: [vagaId], references: [id], onDelete: SetNull)
  destinoId    String
  destino      Destino   @relation(fields: [destinoId], references: [id])
  inicio       DateTime
  fim          DateTime?                      // null = ainda trabalhando
  salario      Decimal?  @db.Decimal(12, 2)
  cep          String?                        // local de trabalho, se diferente da empresa
  cidade       String?
  uf           String?   @db.Char(2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([naveganteId])
  @@index([destinoId])
  @@index([inicio])
}

/// Municípios prioritários do programa (denominador da Cobertura Territorial)
/// e população economicamente ativa (denominador da Densidade de Oportunidades).
model MunicipioPrioritario {
  id                            String   @id @default(cuid())
  codigoIbge                    String?  @unique
  nome                          String
  uf                            String   @db.Char(2)
  populacaoEconomicamenteAtiva  Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([nome, uf])
}
