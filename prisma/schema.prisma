generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                         String          @id @default(cuid())
  nome                       String
  telefone                   String          @unique
  email                      String?         @unique
  senhaHash                  String
  papel                      Papel
  ultimoLoginEm              DateTime?
  criadoEm                   DateTime        @default(now())
  atualizadoEm               DateTime        @updatedAt
  expiracaoTokenRecuperacao  DateTime?
  metodoRecuperacao          String?
  tentativasRecuperacao      Int             @default(0)
  tokenRecuperacao           String?         @db.VarChar(255)
  ultimaTentativaRecuperacao DateTime?
  ativo                      Boolean         @default(true)
  Apoiador                   Apoiador?
  consentimentos             Consentimento[]
  Destino                    Destino?
  Instituicao                Instituicao?
  navegante                  Navegante?
  porto                      Porto?
}

/// Pessoa que busca inserção (Navegante). Ligada a um usuário.
model Navegante {
  id                  String                @id @default(cuid())
  usuarioId           String                @unique
  nomeSocial          String?
  ethosStatus         EthosStatus           @default(NAO_INICIADO)
  ethosBlocoAtual     Int                   @default(0)
  ethosConcluidoEm    DateTime?
  estagioImpacto      EstagioImpacto        @default(ALCANCADO)
  indiceTravessia     Float?
  criadoEm            DateTime              @default(now())
  CotaVaga            CotaVaga[]
  cursos              CursoNavegante[]
  CursoRealizado      CursoRealizado[]
  dadosSensiveis      DadosSensiveis?
  FaixaCepNavegante   FaixaCepNavegante[]
  InscricaoIniciativa InscricaoIniciativa[]
  ApoioIniciativa     ApoioIniciativa[]
  Contratacao         Contratacao[]
  portos              InscricaoPorto[]
  MatchingNavegante   MatchingNavegante?
  usuario             Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  RespostaEthos       RespostaEthos[]
  SnapshotNavegante   SnapshotNavegante[]
  vagas               VagaNavegante[]
}

model DadosSensiveis {
  naveganteId     String    @id
  racaCorCifrado  String?
  religiaoCifrado String?
  generoCifrado   String?
  pcd             Boolean?
  periferia       Boolean?
  navegante       Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
}

model Consentimento {
  id           String            @id @default(cuid())
  usuarioId    String
  tipo         ConsentimentoTipo
  concedido    Boolean
  versaoTermo  String
  registradoEm DateTime          @default(now())
  usuario      Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo, registradoEm])
}

/// Território/organização (igreja, escola, associação, iniciativa). Tem CEP.
model Porto {
  id                  String              @id @default(cuid())
  usuarioId           String?             @unique
  nome                String
  razaoSocial         String?
  cnpj                String?
  cnae                String?
  tipo                TipoPorto?
  cep                 String?
  distrito            String?
  populacaoEstimada   Int?
  taxaDesempregoPct   Float?
  rendaMediaCentavos  Int?
  latitude            Float?
  longitude           Float?
  criadoEm            DateTime            @default(now())
  bairro              String?
  cidade              String?
  codigo              String?             @unique
  complemento         String?
  logradouro          String?
  numero              String?
  uf                  String?
  atualizadoEm        DateTime            @default(now())
  emailContato        String?
  identificador       String?
  nomeFantasia        String?
  status              StatusPorto         @default(EM_ANALISE)
  aprovacaoPendente   Boolean             @default(false)
  telefoneContato     String?
  tipoIdentificador   TipoIdentificador   @default(SEM_REGISTRO)
  assinaturaAteEm     DateTime?
  creditosContratacao Int                 @default(0)
  CotaVaga            CotaVaga[]
  empresas            EmpresaPorto[]
  FormaRecebimento    FormaRecebimento[]
  IniciativaPorto     IniciativaPorto[]
  inscritos           InscricaoPorto[]
  InstituicaoPorto    InstituicaoPorto[]
  InvestimentoPorto   InvestimentoPorto[]
  PedidoRecurso       PedidoRecurso[]
  usuario             Usuario?            @relation(fields: [usuarioId], references: [id])
  vagas               Vaga[]
  cursos              Curso[]
  apoiosIniciativa    ApoioIniciativa[]
  Contratacao         Contratacao[]
  apadrinhadosComo    Apadrinhamento[]    @relation("Padrinho")
  apadrinhadoComo     Apadrinhamento[]    @relation("Afilhado")
  pagamentosPorto     PagamentoPorto[]    @relation("PagadorPorto")
  pagamentosRecebidos PagamentoPorto[]    @relation("AfilhadoPagamento")

  @@index([cidade, uf])
  @@index([cep])
  @@index([cidade])
  @@index([identificador])
}

model InscricaoPorto {
  naveganteId String
  portoId     String
  criadaEm    DateTime    @default(now())
  papel       PapelMembro @default(NAVEGANTE)
  navegante   Navegante   @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
  porto       Porto       @relation(fields: [portoId], references: [id], onDelete: Cascade)

  @@id([naveganteId, portoId])
  @@index([portoId])
}

/// Empresa que oferece vagas (Destino). Tem CEP e CNAE.
model Destino {
  id                   String                 @id @default(cuid())
  usuarioId            String                 @unique
  razaoSocial          String
  cnpj                 String?                @unique
  cnae                 String?
  cep                  String?
  latitude             Float?
  longitude            Float?
  publicidadePermitida Boolean                @default(false)
  bairro               String?
  cidade               String?
  complemento          String?
  logradouro           String?
  numero               String?
  uf                   String?
  cnaesSecundarios     String[]               @default([])
  CotaVaga             CotaVaga[]
  cursos               Curso[]
  Usuario              Usuario                @relation(fields: [usuarioId], references: [id])
  portos               EmpresaPorto[]
  MatchingEmpresa      MatchingEmpresa?
  ModeloVaga           ModeloVaga[]
  NotificacaoEmpresa   NotificacaoEmpresa[]
  PacoteAcompanhamento PacoteAcompanhamento[]
  Pedido               Pedido[]
  vagas                Vaga[]

  @@index([cep])
}

/// Empresa desenvolve portos (N—N).
model EmpresaPorto {
  destinoId String
  portoId   String
  criadoEm  DateTime @default(now())
  destino   Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  porto     Porto    @relation(fields: [portoId], references: [id], onDelete: Cascade)

  @@id([destinoId, portoId])
}

model Vaga {
  id                 String          @id @default(cuid())
  destinoId          String?
  portoId            String?
  titulo             String
  descricao          String
  requisitos         Json?
  salarioMinCentavos Int?
  salarioMaxCentavos Int?
  beneficios         String[]
  latitude           Float?
  longitude          Float?
  ativa              Boolean         @default(true)
  criadaEm           DateTime        @default(now())
  valoresEthos       String[]        @default([])
  cep                String?
  quantidade         Int             @default(1)
  CotaVaga           CotaVaga[]
  destino            Destino?        @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  porto              Porto?          @relation(fields: [portoId], references: [id], onDelete: Cascade)
  cursos             VagaCurso[]
  navegantes         VagaNavegante[]
  contratacoes       Contratacao[]

  @@index([portoId])
}

model Curso {
  id                String           @id @default(cuid())
  instituicaoId     String?
  nome              String
  descricao         String?
  cargaHorariaHoras Int
  inicio            DateTime?
  termino           DateTime?
  vagasDisponiveis  Int?
  modalidade        Modalidade
  cep               String?
  latitude          Float?
  longitude         Float?
  valoresEthos      String[]         @default([])
  destinoId         String?
  portoId           String?
  instituicaoEnsino String?
  destino           Destino?         @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  porto             Porto?           @relation(fields: [portoId], references: [id], onDelete: Cascade)
  Instituicao       Instituicao?     @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  navegantes        CursoNavegante[]
  TrilhaCurso       TrilhaCurso[]
  vagas             VagaCurso[]

  @@index([destinoId])
  @@index([portoId])
}

model VagaCurso {
  vagaId  String
  cursoId String
  curso   Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  vaga    Vaga   @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@id([vagaId, cursoId])
}

model VagaNavegante {
  naveganteId String
  vagaId      String
  criadaEm    DateTime  @default(now())
  navegante   Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
  vaga        Vaga      @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@id([naveganteId, vagaId])
}

model CursoNavegante {
  naveganteId String
  cursoId     String
  criadoEm    DateTime  @default(now())
  curso       Curso     @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  navegante   Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)

  @@id([naveganteId, cursoId])
}

model Administrador {
  id                  String          @id
  login               String          @unique
  nome                String
  senhaHash           String
  ativo               Boolean         @default(true)
  aprovacaoPendente   Boolean         @default(false)
  trocarSenha         Boolean         @default(true)
  tentativasFalhas    Int             @default(0)
  bloqueadoAte        DateTime?
  ultimoLoginEm       DateTime?
  criadoEm            DateTime        @default(now())
  criadoPorId         String?
  Administrador       Administrador?  @relation("AdministradorToAdministrador", fields: [criadoPorId], references: [id])
  other_Administrador Administrador[] @relation("AdministradorToAdministrador")
  convites            ConviteAdministrador[]
}

model ConviteAdministrador {
  tokenHash   String        @id
  criadoPorId String
  criadoEm    DateTime      @default(now())
  expiraEm    DateTime
  usadoEm     DateTime?
  criador     Administrador @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)

  @@index([criadoPorId])
}

model Apoiador {
  id          String  @id
  usuarioId   String  @unique
  razaoSocial String
  cnpj        String? @unique
  Usuario     Usuario @relation(fields: [usuarioId], references: [id])
}

model Cnae {
  codigo      String        @id
  descricao   String
  EmpresaCnpj EmpresaCnpj[]
}

model CotaVaga {
  id          String     @id
  pedidoId    String
  destinoId   String
  vagaId      String?
  naveganteId String?
  portoId     String?
  status      StatusCota @default(DISPONIVEL)
  lotadaEm    DateTime?
  Destino     Destino    @relation(fields: [destinoId], references: [id])
  Navegante   Navegante? @relation(fields: [naveganteId], references: [id])
  Pedido      Pedido     @relation(fields: [pedidoId], references: [id])
  Porto       Porto?     @relation(fields: [portoId], references: [id])
  Vaga        Vaga?      @relation(fields: [vagaId], references: [id])
  NpsSocial   NpsSocial?

  @@index([destinoId, status])
  @@index([portoId])
}

model CursoRealizado {
  id             String      @id
  naveganteId    String
  curso          String
  descricao      String
  cargaHoraria   Int
  instituicao    String
  dataRealizacao DateTime    @db.Date
  criadoEm       DateTime    @default(now())
  modalidade     Modalidade?
  Navegante      Navegante   @relation(fields: [naveganteId], references: [id], onDelete: Cascade)

  @@index([naveganteId])
}

model EmpresaCnpj {
  cnpj         String    @id
  matriz       Boolean
  razaoSocial  String?
  nomeFantasia String?
  cnaeCodigo   String
  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  cidade       String
  cep          String
  latitude     Float?
  longitude    Float?
  porte        String?
  dataInicio   DateTime?
  Cnae         Cnae      @relation(fields: [cnaeCodigo], references: [codigo])

  @@index([cep])
  @@index([cnaeCodigo])
}

model Escola {
  id           String   @id
  fonte        String
  inep         String?
  nome         String
  rede         String?
  etapas       String?
  logradouro   String?
  numero       String?
  bairro       String?
  cidade       String
  cep          String?
  latitude     Float
  longitude    Float
  atualizadoEm DateTime

  @@index([cidade])
}

model FaixaCepNavegante {
  naveganteId String
  ibge        Int
  cidade      String
  cepInicial  String
  cepFinal    String
  criadaEm    DateTime  @default(now())
  Navegante   Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)

  @@id([naveganteId, ibge])
  @@index([cepInicial, cepFinal])
}

model FormaRecebimento {
  id                 String               @id
  portoId            String
  tipo               TipoFormaRecebimento
  titulo             String
  instrucoes         Json
  padrao             Boolean              @default(false)
  criadoEm           DateTime             @default(now())
  atualizadoEm       DateTime
  Porto              Porto                @relation(fields: [portoId], references: [id], onDelete: Cascade)
  PedidoRecursoForma PedidoRecursoForma[]

  @@index([portoId])
}

model IniciativaPorto {
  id                  String                @id
  portoId             String
  categoria           CategoriaIniciativa
  titulo              String
  descricao           String
  modalidade          Modalidade            @default(PRESENCIAL)
  vagasTotais         Int?
  inicio              DateTime?
  termino             DateTime?
  status              StatusIniciativa      @default(ABERTO)
  criadaEm            DateTime              @default(now())
  atualizadaEm        DateTime
  Porto               Porto                 @relation(fields: [portoId], references: [id], onDelete: Cascade)
  InscricaoIniciativa InscricaoIniciativa[]
  ApoioIniciativa     ApoioIniciativa[]

  @@index([categoria, status])
  @@index([portoId])
}

model InscricaoIniciativa {
  id              String                    @id
  iniciativaId    String
  naveganteId     String
  status          StatusInscricaoIniciativa @default(INSCRITO)
  inscritoEm      DateTime                  @default(now())
  atualizadoEm    DateTime
  IniciativaPorto IniciativaPorto           @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  Navegante       Navegante                 @relation(fields: [naveganteId], references: [id], onDelete: Cascade)

  @@unique([iniciativaId, naveganteId])
  @@index([naveganteId])
}

/// Lista de potenciais apoiadores de uma iniciativa: um navegante ou um porto.
model ApoioIniciativa {
  id              String          @id @default(cuid())
  iniciativaId    String
  naveganteId     String?
  portoId         String?
  criadoEm        DateTime        @default(now())
  IniciativaPorto IniciativaPorto @relation(fields: [iniciativaId], references: [id], onDelete: Cascade)
  Navegante       Navegante?      @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
  Porto           Porto?          @relation(fields: [portoId], references: [id], onDelete: Cascade)

  @@unique([iniciativaId, naveganteId])
  @@unique([iniciativaId, portoId])
  @@index([naveganteId])
  @@index([portoId])
}

/// Contratação de um navegante, feita pelo porto via plataforma. Consome um crédito de contratação.
model Contratacao {
  id            String    @id @default(cuid())
  portoId       String
  naveganteId   String
  vagaId        String
  valorCentavos Int
  criadaEm      DateTime  @default(now())
  encerradaEm   DateTime?
  motivoEncerramento String?
  Porto         Porto     @relation(fields: [portoId], references: [id], onDelete: Cascade)
  Navegante     Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
  Vaga          Vaga      @relation(fields: [vagaId], references: [id], onDelete: Cascade)

  @@index([portoId])
  @@index([naveganteId, encerradaEm])
  @@index([vagaId, encerradaEm])
}

/// Porto que apadrinha outro porto. `cotas` são as cotas de apoio já pagas.
model Apadrinhamento {
  padrinhoId String
  afilhadoId String
  cotas      Int      @default(0)
  criadoEm   DateTime @default(now())
  padrinho   Porto    @relation("Padrinho", fields: [padrinhoId], references: [id], onDelete: Cascade)
  afilhado   Porto    @relation("Afilhado", fields: [afilhadoId], references: [id], onDelete: Cascade)

  @@id([padrinhoId, afilhadoId])
}

/// Cobrança do porto: assinatura anual, crédito de contratação ou cotas de apoio a outro porto.
model PagamentoPorto {
  id            String             @id @default(cuid())
  portoId       String
  afilhadoId    String?
  tipo          TipoPagamentoPorto
  quantidade    Int                @default(1)
  valorCentavos Int
  status        PedidoStatus       @default(PENDENTE)
  criadoEm      DateTime           @default(now())
  pagoEm        DateTime?
  porto         Porto              @relation("PagadorPorto", fields: [portoId], references: [id], onDelete: Cascade)
  afilhado      Porto?             @relation("AfilhadoPagamento", fields: [afilhadoId], references: [id], onDelete: Cascade)

  @@index([portoId, status])
}

model Instituicao {
  id                   String                 @id
  usuarioId            String                 @unique
  razaoSocial          String
  cnpj                 String?                @unique
  Curso                Curso[]
  Usuario              Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  InstituicaoPorto     InstituicaoPorto[]
  PacoteAcompanhamento PacoteAcompanhamento[]
  Trilha               Trilha[]
}

model InstituicaoPorto {
  instituicaoId String
  portoId       String
  criadoEm      DateTime    @default(now())
  Instituicao   Instituicao @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  Porto         Porto       @relation(fields: [portoId], references: [id], onDelete: Cascade)

  @@id([instituicaoId, portoId])
}

model InvestimentoPorto {
  id            String   @id
  pedidoId      String
  portoId       String
  valorCentavos Int
  criadoEm      DateTime @default(now())
  Pedido        Pedido   @relation(fields: [pedidoId], references: [id])
  Porto         Porto    @relation(fields: [portoId], references: [id])

  @@index([portoId])
}

model Lead {
  id              String         @id
  nome            String
  email           String?        @unique
  telefone        String         @unique
  tipoAgente      Papel
  status          StatusLead     @default(NOVO)
  localizacao     String?
  descricaoOrgao  String?
  motivacao       String?
  contatoNome     String?
  contatoTelefone String?
  contatoEmail    String?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime
  proximoContato  DateTime?
  observacoes     String?
  RespostaLead    RespostaLead[]

  @@index([email])
  @@index([status, tipoAgente])
  @@index([telefone])
}

model MatchingEmpresa {
  destinoId    String   @id
  perfil       Json
  assinatura   String
  atualizadoEm DateTime
  Destino      Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)
}

model MatchingNavegante {
  naveganteId  String    @id
  perfil       Json
  assinatura   String
  atualizadoEm DateTime
  Navegante    Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)
}

model ModeloVaga {
  id        String   @id
  destinoId String
  nome      String
  dados     Json
  criadoEm  DateTime @default(now())
  Destino   Destino  @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@index([destinoId])
}

model MunicipioPrioritario {
  id                           String   @id
  codigoIbge                   String?  @unique
  nome                         String
  uf                           String   @db.Char(2)
  populacaoEconomicamenteAtiva Int?
  criadoEm                     DateTime @default(now())
  atualizadoEm                 DateTime

  @@unique([nome, uf])
}

model NotificacaoEmpresa {
  id           String          @id
  destinoId    String
  tipo         TipoNotificacao
  mensagem     String
  quantidade   Int             @default(0)
  lida         Boolean         @default(false)
  criadaEm     DateTime        @default(now())
  atualizadaEm DateTime
  Destino      Destino         @relation(fields: [destinoId], references: [id], onDelete: Cascade)

  @@index([destinoId, lida])
}

model NpsSocial {
  id           String   @id
  cotaVagaId   String   @unique
  nota         Int
  respondidaEm DateTime @default(now())
  CotaVaga     CotaVaga @relation(fields: [cotaVagaId], references: [id], onDelete: Cascade)
}

model PacoteAcompanhamento {
  id                    String       @id
  destinoId             String?
  instituicaoId         String?
  quantidadePessoas     Int
  valorUnitarioCentavos Int
  totalCentavos         Int
  status                PedidoStatus @default(PENDENTE)
  criadoEm              DateTime     @default(now())
  pagoEm                DateTime?
  Destino               Destino?     @relation(fields: [destinoId], references: [id], onDelete: Cascade)
  Instituicao           Instituicao? @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)

  @@index([destinoId])
  @@index([instituicaoId])
}

model Pedido {
  id                          String              @id
  destinoId                   String
  quantidadeVagas             Int
  valorCotaCentavos           Int
  acompanhamentoTerritorio    Boolean             @default(false)
  valorAcompanhamentoCentavos Int                 @default(0)
  totalCentavos               Int
  status                      PedidoStatus        @default(PENDENTE)
  metodo                      MetodoPagamento?
  gatewayRef                  String?
  criadoEm                    DateTime            @default(now())
  pagoEm                      DateTime?
  CotaVaga                    CotaVaga[]
  InvestimentoPorto           InvestimentoPorto[]
  Destino                     Destino             @relation(fields: [destinoId], references: [id])
}

model PedidoRecurso {
  id                   String               @id
  portoId              String
  categoria            CategoriaRecurso
  titulo               String
  descricao            String
  urgencia             Urgencia             @default(MEDIA)
  quantidadeMeta       Decimal?             @db.Decimal(12, 2)
  quantidadeArrecadada Decimal?             @default(0) @db.Decimal(12, 2)
  unidade              String?
  status               StatusPedidoRecurso  @default(ABERTA)
  criadoEm             DateTime             @default(now())
  atualizadoEm         DateTime
  Porto                Porto                @relation(fields: [portoId], references: [id], onDelete: Cascade)
  PedidoRecursoForma   PedidoRecursoForma[]

  @@index([categoria, status])
  @@index([portoId])
}

model PedidoRecursoForma {
  pedidoRecursoId    String
  formaRecebimentoId String
  FormaRecebimento   FormaRecebimento @relation(fields: [formaRecebimentoId], references: [id], onDelete: Cascade)
  PedidoRecurso      PedidoRecurso    @relation(fields: [pedidoRecursoId], references: [id], onDelete: Cascade)

  @@id([pedidoRecursoId, formaRecebimentoId])
  @@index([formaRecebimentoId])
}

model RespostaEthos {
  id                 String    @id
  naveganteId        String
  bloco              Int
  questaoId          String
  valor              Json
  versaoQuestionario String
  atualizadoEm       DateTime
  Navegante          Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)

  @@unique([naveganteId, questaoId])
}

model RespostaLead {
  id           String   @id
  leadId       String
  blocoId      String
  questaoId    String
  valor        String
  respondidoEm DateTime @default(now())
  Lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, questaoId])
  @@index([leadId, blocoId])
}

model SnapshotNavegante {
  id                   String    @id
  naveganteId          String
  registradoEm         DateTime  @default(now())
  origem               String
  rendaIndividualFaixa String?
  rendaFamiliarFaixa   String?
  situacaoProfissional String?
  escolaridade         String?
  cargo                String?
  satisfacao           Int?
  perspectivaFuturo    Int?
  Navegante            Navegante @relation(fields: [naveganteId], references: [id], onDelete: Cascade)

  @@index([naveganteId, registradoEm])
}

model Trilha {
  id            String        @id
  instituicaoId String
  nome          String
  descricao     String?
  Instituicao   Instituicao   @relation(fields: [instituicaoId], references: [id], onDelete: Cascade)
  TrilhaCurso   TrilhaCurso[]
}

model TrilhaCurso {
  trilhaId String
  cursoId  String
  ordem    Int
  Curso    Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  Trilha   Trilha @relation(fields: [trilhaId], references: [id], onDelete: Cascade)

  @@id([trilhaId, cursoId])
}

